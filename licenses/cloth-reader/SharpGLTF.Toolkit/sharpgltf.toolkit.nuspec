<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>SharpGLTF.Toolkit</id>
    <version>1.0.6</version>
    <authors>Vicente Penades</authors>
    <license type="expression">MIT</license>
    <licenseUrl>https://licenses.nuget.org/MIT</licenseUrl>
    <icon>glTF2Sharp.png</icon>
    <projectUrl>https://github.com/vpenades/SharpGLTF</projectUrl>
    <description>SharpGLTF is a C# library for reading and writing glTF2 3D models</description>
    <copyright>Copyright (c) 2025 Vicente Penades</copyright>
    <tags>C# glTF 3D</tags>
    <repository type="git" url="https://github.com/vpenades/SharpGLTF" commit="5153478a209ca2e276d8092f7166ff9d7ae4974f" />
    <dependencies>
      <group targetFramework="net6.0">
        <dependency id="SharpGLTF.Runtime" version="1.0.6" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net8.0">
        <dependency id="SharpGLTF.Runtime" version="1.0.6" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net10.0">
        <dependency id="SharpGLTF.Runtime" version="1.0.6" exclude="Build,Analyzers" />
      </group>
      <group targetFramework=".NETStandard2.0">
        <dependency id="SharpGLTF.Runtime" version="1.0.6" exclude="Build,Analyzers" />
      </group>
      <group targetFramework=".NETStandard2.1">
        <dependency id="SharpGLTF.Runtime" version="1.0.6" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>