<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>ValvePak</id>
    <version>5.0.2.177</version>
    <authors>ValvePak Contributors</authors>
    <license type="expression">MIT</license>
    <licenseUrl>https://licenses.nuget.org/MIT</licenseUrl>
    <icon>logo.png</icon>
    <readme>README.md</readme>
    <projectUrl>https://valveresourceformat.github.io/</projectUrl>
    <description>Fully fledged library to work with Valve's Pak (VPK) archives</description>
    <releaseNotes>View release notes at https://github.com/ValveResourceFormat/ValvePak/releases</releaseNotes>
    <copyright>Copyright © ValvePak Contributors</copyright>
    <tags>steam valve archive pak vpk csgo dota2 tf2</tags>
    <repository type="git" url="https://github.com/ValveResourceFormat/ValvePak" commit="2adb4b00ed950b5ced012d8b6ac83d2d3a95ec29" />
    <dependencies>
      <group targetFramework="net10.0">
        <dependency id="Blake3" version="3.0.2" exclude="Build,Analyzers" />
        <dependency id="System.IO.Hashing" version="10.0.10" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>