<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>ValveResourceFormat</id>
    <version>20.0.6980</version>
    <authors>ValveResourceFormat Contributors</authors>
    <license type="expression">MIT</license>
    <licenseUrl>https://licenses.nuget.org/MIT</licenseUrl>
    <icon>source2viewer_dark.png</icon>
    <readme>README.md</readme>
    <projectUrl>https://valveresourceformat.github.io/</projectUrl>
    <description>Parser, decompiler, and exporter for Valve's Source 2 resource file formats. Supports models, textures, materials, maps, particles, and more.</description>
    <releaseNotes>View release notes at https://github.com/ValveResourceFormat/ValveResourceFormat/releases</releaseNotes>
    <copyright>Copyright © ValveResourceFormat Contributors</copyright>
    <tags>source2 dota2 dota steam valve halflife artifact underlords</tags>
    <repository type="git" url="https://github.com/ValveResourceFormat/ValveResourceFormat" commit="a06886f7d06049052d32a7381ec05523064a2ca0" />
    <dependencies>
      <group targetFramework="net10.0">
        <dependency id="K4os.Compression.LZ4" version="1.3.8" exclude="Build,Analyzers" />
        <dependency id="KeyValues2" version="0.8.0" exclude="Build,Analyzers" />
        <dependency id="SharpGLTF.Toolkit" version="1.0.6" exclude="Build,Analyzers" />
        <dependency id="SkiaSharp" version="4.151.1" exclude="Build,Analyzers" />
        <dependency id="SkiaSharp.NativeAssets.Linux.NoDependencies" version="4.151.1" exclude="Build,Analyzers" />
        <dependency id="System.IO.Hashing" version="10.0.10" exclude="Build,Analyzers" />
        <dependency id="TinyBCSharp" version="0.1.2" exclude="Build,Analyzers" />
        <dependency id="TinyEXR.NET" version="1.1.0" exclude="Build,Analyzers" />
        <dependency id="ValveKeyValue" version="0.70.0.499" exclude="Build,Analyzers" />
        <dependency id="ValvePak" version="5.0.2.177" exclude="Build,Analyzers" />
        <dependency id="Vortice.SpirvCross" version="1.5.4" exclude="Build,Analyzers" />
        <dependency id="ZstdSharp.Port" version="0.8.8" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>