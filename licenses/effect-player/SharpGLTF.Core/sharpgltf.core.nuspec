<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>SharpGLTF.Core</id>
    <version>1.0.7</version>
    <authors>Vicente Penades</authors>
    <license type="expression">MIT</license>
    <licenseUrl>https://licenses.nuget.org/MIT</licenseUrl>
    <icon>glTF2Sharp.png</icon>
    <projectUrl>https://github.com/vpenades/SharpGLTF</projectUrl>
    <description>SharpGLTF is a C# library for reading and writing glTF2 3D models</description>
    <copyright>Copyright (c) 2026 Vicente Penades</copyright>
    <tags>C# glTF 3D</tags>
    <repository type="git" url="https://github.com/vpenades/SharpGLTF" commit="acbc151e70d65ceb8bec24fa95f0067d0e5ed933" />
    <dependencies>
      <group targetFramework="net10.0" />
      <group targetFramework="net6.0" />
      <group targetFramework="net8.0" />
      <group targetFramework=".NETStandard2.0">
        <dependency id="System.Text.Json" version="10.0.12" exclude="Build,Analyzers" />
      </group>
      <group targetFramework=".NETStandard2.1">
        <dependency id="System.Text.Json" version="10.0.12" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>