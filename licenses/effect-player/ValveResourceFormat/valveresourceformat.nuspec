<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>ValveResourceFormat</id>
    <version>21.1.7798</version>
    <authors>ValveResourceFormat Contributors</authors>
    <license type="expression">MIT</license>
    <licenseUrl>https://licenses.nuget.org/MIT</licenseUrl>
    <icon>source2viewer_dark.png</icon>
    <readme>README.md</readme>
    <projectUrl>https://s2v.app/</projectUrl>
    <description>Parser, decompiler, and exporter for Valve's Source 2 resource file formats. Supports models, textures, materials, maps, particles, and more.</description>
    <releaseNotes>View release notes at https://github.com/ValveResourceFormat/ValveResourceFormat/releases</releaseNotes>
    <copyright>Copyright © ValveResourceFormat Contributors</copyright>
    <tags>source2 dota2 dota steam valve halflife artifact underlords</tags>
    <repository type="git" url="https://github.com/ValveResourceFormat/ValveResourceFormat" commit="942df5b37ebbde6153f6c488880b91d4bed003e6" />
    <dependencies>
      <group targetFramework="net11.0">
        <dependency id="K4os.Compression.LZ4" version="1.3.8" exclude="Build,Analyzers" />
        <dependency id="KeyValues2" version="2.0.0-rc2" exclude="Build,Analyzers" />
        <dependency id="SharpGLTF.Core" version="1.0.7" exclude="Build,Analyzers" />
        <dependency id="SkiaSharp" version="4.153.1" exclude="Build,Analyzers" />
        <dependency id="SkiaSharp.NativeAssets.Linux.NoDependencies" version="4.153.1" exclude="Build,Analyzers" />
        <dependency id="System.IO.Hashing" version="11.0.0" exclude="Build,Analyzers" />
        <dependency id="System.Numerics.Tensors" version="11.0.0" exclude="Build,Analyzers" />
        <dependency id="TinyBCSharp" version="0.1.2" exclude="Build,Analyzers" />
        <dependency id="ValveKeyValue" version="0.80.0.542" exclude="Build,Analyzers" />
        <dependency id="ValvePak" version="7.2.0.221" exclude="Build,Analyzers" />
        <dependency id="Vortice.SpirvCross" version="1.6.0" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>